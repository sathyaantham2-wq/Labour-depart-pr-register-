# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — Project Settings > API (local stack: shown by `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used later by notice/callback API routes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used in magic-link emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email — Resend (https://resend.com). Sent directly by the app, no Make.com involved.
# NOTICES_FROM_EMAIL must use a domain verified in the Resend dashboard for real delivery;
# their shared onboarding@resend.dev address works for early testing only (limited, and only
# delivers to the account owner's own email).
RESEND_API_KEY=
NOTICES_FROM_EMAIL=

# Make.com webhook — WhatsApp only now (email is sent directly, see above). Needs a WhatsApp
# Business API provider (Gupshup / 360dialog / Twilio) connected in Make.com; see automation/.
MAKE_WEBHOOK_URL=
MAKE_WEBHOOK_SECRET=

# Local PostgreSQL for schema + RLS tests (npm run db:local:reset / db:local:test).
# Database name must end in _dev or _test.
LOCAL_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/labour_dev
